# Database Configuration (PostgreSQL 15 Local)
DATABASE_URL="postgresql://moneymaker_user:postgre123@localhost:5433/moneymaker_dev?schema=public"
DATABASE_NAME=moneymaker_dev
DATABASE_USER=moneymaker_user
DATABASE_PASSWORD=postgre123

# Redis Configuration (Local)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=  # Deixe vazio se não configurou senha

# Application
NODE_ENV=development
APP_PORT=3000

# JWT Configuration
JWT_SECRET=seu-jwt-secret-super-seguro-mude-isso-em-producao-123456789
JWT_EXPIRATION=30d

# Telegram (opcional - pode deixar vazio em dev)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT=30000
TELEGRAM_CONNECT_TIMEOUT=15000
TELEGRAM_READ_TIMEOUT=30000
TELEGRAM_MAX_RETRIES=3
TELEGRAM_RETRY_DELAY=2000

# Prometheus
PROMETHEUS_METRICS_PORT=9091

# Stripe (opcional - pode deixar vazio em dev)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# AI Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
CHROMADB_URL=http://localhost:8000

# Frontend URL (para CORS do WebSocket)
FRONTEND_URL=http://localhost:3001

