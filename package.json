{
  "name": "moneymaker-backend",
  "version": "1.0.0",
  "description": "Backend SaaS Multi-tenant para soluções digitais",
  "author": "Guillermo",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "build:native": "cd src/modules/products/native && node-gyp rebuild",
    "build:native:configure": "cd src/modules/products/native && node-gyp configure",
    "build:native:clean": "cd src/modules/products/native && node-gyp clean",
    "build:ts": "nest build",
    "build:clean": "nest build --tsc",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:health": "jest --testPathPattern=health-check.spec.ts --verbose",
    "test:redis": "jest --testPathPattern=redis.spec.ts --verbose",
    "test:telegram": "jest --testPathPattern=telegram.spec.ts --verbose",
    "test:metrics": "jest --testPathPattern=metrics.spec.ts --verbose",
    "test:all": "jest --testPathPattern=test/.*.spec.ts --verbose",
    "test:integration": "jest --testPathPattern=health-check.spec.ts --verbose --runInBand",
    "test:routes": "jest --testPathPattern=absolute-route-tester.spec.ts --verbose --runInBand",
    "test:routes:custom": "jest --testPathPattern=absolute-route-tester.spec.ts -t 'Seus Testes Customizados' --verbose --runInBand",
    "test:quick": "ts-node src/test/quick-route-test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:seed-intensive": "ts-node prisma/intensive-seed.ts",
    "prisma:seed-bemmecare": "ts-node prisma/seed-bemmecare.ts",
    "prisma:reset": "prisma migrate reset --force",
    "prisma:clean": "prisma migrate reset --force && npm run prisma:seed-bemmecare",
    "db:clean": "powershell -ExecutionPolicy Bypass -File scripts/clean-database.ps1",
    "db:clean:bash": "bash scripts/clean-database.sh",
    "db:clean:smart": "powershell -ExecutionPolicy Bypass -File scripts/clean-database-smart.ps1",
    "db:clean:aggressive": "powershell -ExecutionPolicy Bypass -File scripts/clean-database-aggressive.ps1",
    "test:users": "ts-node scripts/create-test-users.ts",
    "test:performance": "ts-node scripts/performance-tests.ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:dev": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up -d",
    "docker:dev:build": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build",
    "docker:dev:logs": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml logs -f app",
    "prisma:seed-expatriamente": "ts-node prisma/seed-expatriamente-updated.ts",
    "prisma:seed-expatriamente-heavy": "ts-node prisma/seed-expatriamente-heavy.ts",
    "prisma:seed-expatriamente-users": "ts-node prisma/seed-expatriamente-users.ts",
    "prisma:set-passwords": "ts-node prisma/set-default-passwords.ts",
    "prisma:seed-migrate": "ts-node prisma/seed-migrate-working-hours.ts",
    "seed:local": "ts-node prisma/seed-complete-local.ts",
    "seed:comprehensive": "ts-node prisma/seed-comprehensive.ts",
    "seed:full": "npm run seed:local && npm run seed:comprehensive"
  },
  "dependencies": {
    "@chroma-core/default-embed": "^0.1.8",
    "@langchain/community": "^0.3.57",
    "@langchain/core": "^0.3.78",
    "@nestjs/axios": "^3.1.3",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/platform-socket.io": "^10.4.20",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/terminus": "^10.2.3",
    "@nestjs/throttler": "^6.2.1",
    "@nestjs/websockets": "^10.4.20",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "chromadb": "^3.0.17",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.4",
    "dotenv": "^16.3.1",
    "express-rate-limit": "^7.1.5",
    "grammy": "^1.37.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "nest-winston": "^1.10.2",
    "node-addon-api": "^8.5.0",
    "node-telegram-bot-api": "^0.64.0",
    "nodemailer": "^7.0.9",
    "ollama": "^0.5.18",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "prisma": "^5.6.0",
    "prom-client": "^15.1.3",
    "redis": "^4.6.13",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "stripe": "^19.1.0",
    "uuid": "^9.0.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.4.4",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/nodemailer": "^6.4.14",
    "@types/passport-jwt": "^3.0.13",
    "@types/passport-local": "^1.0.38",
    "@types/socket.io": "^3.0.2",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "null-loader": "^4.0.1",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "4.2.0",
    "typescript": "^5.1.3",
    "wait-on": "^8.0.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed-bemmecare.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@/common/(.*)$": "<rootDir>/common/$1",
      "^@/modules/(.*)$": "<rootDir>/modules/$1",
      "^@/config/(.*)$": "<rootDir>/config/$1",
      "^@/database/(.*)$": "<rootDir>/database/$1"
    }
  }
}
